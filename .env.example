# Extract to Act — environment configuration
#
# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored and must never be committed.
# In production (Render), these are set via the platform's environment
# variable configuration, never via a committed file.
#
# This file exists purely to document what the application needs — most
# variables below are not yet consumed by any code (Phase 1: no application
# code exists yet). It will be kept in sync as each owning phase is built.

# --- Application ---
APP_ENV=development                 # development | production
APP_SECRET_KEY=                     # session/auth signing key — generate a random value, never reuse across environments

# --- Database (Phase 2/3) ---
DATABASE_URL=postgresql://user:password@localhost:5432/extract_to_act

# --- Object storage (Phase 4) ---
# S3-compatible: Cloudflare R2 or Backblaze B2 in production, local disk in dev.
STORAGE_BACKEND=local                # local | s3
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Extraction providers (Phase 5/6 — provider choice not yet decided, see docs/adr/0006) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=                   # used for Claude vision extraction comparison and/or semantic-assist normalization

# --- Notifications (Phase 12) ---
NOTIFICATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Accounting adapter (Phase 12 mock; Phase 19 real adapter) ---
ACCOUNTING_BACKEND=mock              # mock | xero | quickbooks
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# --- Business rules (Phase 11 — dollar figure is a product decision, not yet set) ---
APPROVAL_THRESHOLD_AMOUNT=
