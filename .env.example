# Extract to Act — environment configuration
#
# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored and must never be committed.
# In production (Render), these are set via the platform's environment
# variable configuration, never via a committed file.
#
# This file exists purely to document what the application needs — most
# variables below are not yet consumed by any code. It's kept in sync as
# each owning phase is built (see PLAN.md).
#
# Formatting notes:
#  - a variable's explanation goes in a comment ABOVE it, never trailing
#    after the `=` — python-dotenv does not reliably strip a trailing
#    comment when there's no value before it, so `KEY=   # comment` can
#    silently become `KEY="   # comment"` instead of an empty string.
#  - a variable meant to fall back to its (documented, dev-only-safe)
#    code default is left commented out here, not set to an empty value.
#    Pydantic-settings treats a *present* env var — even `KEY=` with
#    nothing after it — as an explicit override, so an empty assignment
#    silently becomes the empty string instead of the intended default.
#    Uncomment and set a real value to actually override it.

# --- Application ---
# development | production
APP_ENV=development

# Session/auth signing key. Code falls back to an insecure dev-only
# placeholder ("dev-only-not-for-production") if this line stays
# commented out — fine for local dev. Any shared or production
# deployment must uncomment this and set a real random value via
# Render's env config, never a committed file.
# APP_SECRET_KEY=replace-with-a-real-random-value

# --- API authentication (Phase 4 — see docs/adr/0008-api-authentication.md) ---
# Shared bearer token for all endpoints. Same fallback behavior as
# APP_SECRET_KEY above — the dev-only default is the literal string
# "dev-only-not-for-production" (see app/config.py) unless this is
# uncommented and set.
# API_KEY=replace-with-a-real-random-value

# --- Database (Phase 3) ---
# Scheme must be postgresql+psycopg:// (SQLAlchemy 2.0 + psycopg 3 — see
# docs/adr/0007-database-access.md). Host `db` matches the docker-compose
# service name; use `localhost` if connecting from outside Docker.
DATABASE_URL=postgresql+psycopg://extract_to_act:extract_to_act@db:5432/extract_to_act

# --- Object storage (Phase 4) ---
# S3-compatible: Cloudflare R2 or Backblaze B2 in production, local disk in
# dev. Only the local backend is implemented so far — STORAGE_BACKEND/
# BUCKET/ENDPOINT_URL/ACCESS_KEY_ID/SECRET_ACCESS_KEY below are not yet
# consumed by any code; the S3-compatible StorageProvider is a later phase.
# local | s3
STORAGE_BACKEND=local
# local backend only
STORAGE_LOCAL_DIR=/app/data/uploads
# 20 MiB
MAX_UPLOAD_SIZE_BYTES=20971520
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Extraction provider (Phase 6 — Mistral OCR, see docs/adr/0006) ---
# Consumed by app/config.py + app/extraction.py. Required for the real
# MistralExtractionProvider to work in a live deployment; app tests
# never touch it (a fake provider is dependency-injected instead — see
# tests/test_documents_api.py).
MISTRAL_API_KEY=

# --- Not used by the application — evaluation-only (spike/, Phase 5) ---
# Azure was excluded from the extraction-provider comparison by scope
# decision; Claude was excluded from the real run for credential-safety
# reasons. Both remain documented, ready options if reconsidered later
# (docs/adr/0006-extraction-provider.md) but neither is wired into the app.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
ANTHROPIC_API_KEY=

# --- Notifications (Phase 12) ---
# Not consumed by any code yet — Phase 12 shipped only
# LogNotificationProvider (app/accounting.py), which logs instead of
# sending real email. These document what a real SMTP adapter would
# need, the same way the accounting vars below document a future real
# ledger integration; wiring them up is a later, explicitly deferred
# step, not an oversight.
NOTIFICATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Accounting adapter (Phase 12 mock; Phase 19 real adapter) ---
# Not consumed by any code yet either — Phase 12 shipped only
# MockAccountingProvider (app/accounting.py), which writes to the
# internal ap_ledger_entries table, not a real backend. mock | xero |
# quickbooks documents where a backend-selection setting would plug in
# once a real adapter exists.
ACCOUNTING_BACKEND=mock
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# --- Reliability & recovery (Phase 13) ---
# How many times a single external-provider call (extraction, the
# accounting write) is retried, with exponential backoff, before it's
# treated as a technical failure.
RETRY_ATTEMPTS=3
# Notifications are lower-stakes — fewer attempts, per docs/reliability.md.
NOTIFICATION_RETRY_ATTEMPTS=2
# How long a document can sit in an in-flight state (EXTRACTING,
# VALIDATING, ACTIONED) before app/worker.py treats it as stuck from a
# crash and resumes it.
WORKER_STUCK_TIMEOUT_SECONDS=300
# How many times the worker will attempt to resume the same stuck
# document before giving up and marking it FAILED.
WORKER_MAX_RETRIES=3

# --- Business rules (Phase 11) ---
# 1000.00 is app/config.py's placeholder default (a portfolio-demo
# figure, not a real business decision) — override for a real deployment.
# Blank is also valid: an empty value falls back to that same default.
APPROVAL_THRESHOLD_AMOUNT=1000.00
